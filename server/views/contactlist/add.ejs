<%- include ../partials/header.ejs %>

<%- include ../partials/main_nav.ejs %>

<div class="container" style="background-color: lightgray;">
<div class="row">
    <div class="offset-md-2 col-md-4">
        <h1><%=title %></h1>

        <form class="form" method="POST">
            
            <div class="form-group">
            <label for="nameTextField">Name</label>
            <input type="text" class="form-control" id="nameTextField"
            placeholder="Enter the contact name:"
            name="Name" required>
            </div>

           <div class="form-group">
            <label for="numberTextField">Contact Number</label>
            <input type="text" class="form-control" id="numberTextField"
                    placeholder="Enter the contact number (e.g. 123-456-7890)"
                    name="Contactnumber"
                    pattern="\d{3}-\d{3}-\d{4}"
                    required>
            </div>

            <div class="form-group">
                <label for="nameTextField">"Address"</label>
                <input type="text" class="form-control" id="nameTextField"
                placeholder="Enter the adress:" name="Address" required>

            </div>

           <div class="form-group">
            <label for="numberTextField">Age</label>
            <input type="number" class="form-control" id="numberTextField"
                    name="Age" placeholder="Enter your age"
                    min="0" max="120" required>
            </div>

             <div class="form-group">
            <label for="sexSelect">Sex</label>
            <select class="form-control" id="sexSelect" name="Sex" required>
                <option value="">Select your sex</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
                <option value="Prefer not to say">Prefer not to say</option>
            </select>
            </div>
           <div class="form-group">
            <label for="emailTextField">Email</label>
            <input type="email" class="form-control" id="emailTextField"
                    name="Email"
                    placeholder="Enter your email"
                    pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
                    title="Enter a valid email address (e.g. user@example.com)"
                    required>
            </div>

            <button class="btn btn-primary" type="Submit">
            <i class="fas fa-edit"></i>Submit</button>

            <a href="/contactlist" class="btn btn-warning">
             <i class="fas fa-undo">Cancel</i>
             </a>
    
        </form>

    </div>
    
 </div> 
</div>


<%- include ../partials/bottom_nav.ejs %>  

<%- include ../partials/footer.ejs %>