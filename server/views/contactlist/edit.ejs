<%- include ../partials/header.ejs %>

<%- include ../partials/main_nav.ejs %>

<div class="container" style="background-color: lightgray;">
<div class="row">
    <div class="offset-md-3 col-md-6">
        <h1><%=title %></h1>

        <form class="form" method="POST">

  <div class="form-group">
    <label for="nameTextField">Name</label>
    <input type="text" class="form-control" id="nameTextField"
           placeholder="Enter the contact name:"
           name="Name" value="<%= contactlist.Name %>" required>
  </div>

  <div class="form-group">
    <label for="numberTextField">Contact Number</label>
    <input type="text" class="form-control" id="numberTextField"
           placeholder="Enter the contact number (e.g. 123-456-7890)"
           name="Contactnumber" value="<%= contactlist.Contactnumber %>"
           pattern="\d{3}-\d{3}-\d{4}" required>
  </div>

  <div class="form-group">
    <label for="addressTextField">Address</label>
    <input type="text" class="form-control" id="addressTextField"
           placeholder="Enter the address:"
           name="Address" value="<%= contactlist.Address %>" required>
  </div>

  <div class="form-group">
    <label for="ageTextField">Age</label>
    <input type="number" class="form-control" id="ageTextField"
           name="Age" placeholder="Enter your age"
           min="0" max="120" value="<%= contactlist.Age %>" required>
  </div>

  <div class="form-group">
    <label for="sexSelect">Sex</label>
    <select class="form-control" id="sexSelect" name="Sex" required>
      <option value="">Select your sex</option>
      <option value="Male" <%= contactlist.Sex === 'Male' ? 'selected' : '' %>>Male</option>
      <option value="Female" <%= contactlist.Sex === 'Female' ? 'selected' : '' %>>Female</option>
      <option value="Other" <%= contactlist.Sex === 'Other' ? 'selected' : '' %>>Other</option>
      <option value="Prefer not to say" <%= contactlist.Sex === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
    </select>
  </div>

  <div class="form-group">
    <label for="emailTextField">Email</label>
    <input type="email" class="form-control" id="emailTextField"
           name="Email" placeholder="Enter your email"
           pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
           title="Enter a valid email address (e.g. user@example.com)"
           value="<%= contactlist.Email %>" required>
  </div>

  <button class="btn btn-primary" type="submit">
    <i class="fas fa-edit"></i> Submit
  </button>

  <a href="/contactlist" class="btn btn-warning">
    <i class="fas fa-undo"></i> Cancel
  </a>

</form>
    </div>
    
 </div> 
</div>


<%- include ../partials/bottom_nav.ejs %>  

<%- include ../partials/footer.ejs %>