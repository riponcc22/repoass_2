<%- include ../partials/header.ejs %>

<%- include ../partials/main_nav.ejs %>

<% const isLoggedIn = typeof displayName === 'string' && displayName; %>

<main class="container" style="background-color: lightgray;">
    <div class="row">
        <div class="offset-md-1 col-md-10">
            <h1><%= title %></h1>

            <% if(isLoggedIn) { %>
            <br>
            <div class="text-center">
                <a href="/contactlist/add" class="btn btn-primary" role="button">
                    <i class="fas fa-plus-circle"></i> Add New Contact
                </a>
            </div>
            <% } %>

            <br>
            <table class="table table-bordered table-striped table-hover">
                <tr class="d-flex">
                    <th class="text-center col-2">Name</th>
                    <th class="text-center col-2">Contact Number</th>
                    <th class="text-center col-4">Email</th>
                    <% if(isLoggedIn) { %>
                        <th class="text-center col-2">Edit Option</th>
                        <th class="text-center col-2">Delete Option</th>
                    <% } %>
                </tr>

                <% contactlist.forEach(contact => { %>
                <tr class="d-flex">
                    <td class="text-center col-2"><%= contact.Name %></td>
                    <td class="text-center col-2"><%= contact.Contactnumber %></td>
                    <td class="text-center col-4"><%= contact.Email %></td>

                    <% if(isLoggedIn) { %>
                        <td class="text-center col-2">
                            <a href="/contactlist/edit/<%= contact._id %>" class="btn btn-primary btn-sm">
                                <i class="fas fa-pencil-alt"></i> Edit
                            </a>
                        </td>
                        <td class="text-center col-2">
                            <a href="/contactlist/delete/<%= contact._id %>" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash-alt"></i> Delete
                            </a>
                        </td>
                    <% } %>
                </tr>
                <% }); %>

            </table>
        </div>
    </div>
</main>

<%- include ../partials/bottom_nav.ejs %>  

<%- include ../partials/footer.ejs %>