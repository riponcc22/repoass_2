        <%- include ../partials/header.ejs %>

        <%- include ../partials/main_nav.ejs %>


        <main class="container" style="background-color: lightgray;">
       <!-- Message Area-->
        <% if(messages.length > 0) {%>
         <div class="alert alert-danger">
        <%= messages %>
          </div>
        <% } %>

        <div class="row">
            <div class="offset-md-3 col-md-4">
            

                <h1> Login here: </h1>

                <form action="" method="POST" autocomplete="off" id="login-form">
                    <fieldset class="form-group">
                    <label for="userName">User Name:</label>
                    <input type="text" class="form-control" 
                    placeholder="Enter user Name"
                    name="username" id="userName"  required autofocus>
                    
                </fieldset>

                <fieldset class="form-group">
                    <label for="password">Password: </label>
                    <input type="password" class="form-control" id="password"
                    placeholder="Enter the password:"
                    name="password"  required>

                     or Don't have an account? 
                    <a href="/register">Register Here</a>
                
                </fieldset>
                   

                <fieldset class="form-group text-right">
                        <input type="submit" class="btn btn-success" value="Login">


                        <a href="/home">
                        <input type="button" class="btn btn-warning" value="Cancel">

                        </a>

                </fieldset>
            
                </form>

                <p id="error-message" style="color: rgba(255, 0, 0, 0.356);"></p>

            </div>
            
        </div> 

        </main>
